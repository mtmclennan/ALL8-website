# Canonical origin and deployment mode
# SITE_URL must be an HTTPS origin with no path, query or trailing slash.
# Only DEPLOYMENT_ENV=production permits indexing.
SITE_URL=https://all8webworks.com
DEPLOYMENT_ENV=production

# Public analytics configuration
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_BUILD_TIME=

# Sanity public project configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-11-19

# Lead-form verification
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.3

# Set true only when Next.js is reachable exclusively through the trusted
# local Nginx proxy in deploy/nginx/all8-tunnel.conf.example.
TRUST_PROXY_IP_HEADER=false

# Rate limiting (server only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Primary lead capture (server only)
BREVO_API_KEY=
CONTACT_TO=hello@all8webworks.com
CONTACT_CC=
ALL8_LOGO_URL=https://all8webworks.com/assets/all8-webworks-web-design-and-development-logo.webp

# HubSpot enrichment (server only)
HS_PORTAL_ID=
HS_FORM_GUID=
HUBSPOT_TOKEN=
HS_CONSENT_TEXT=
HS_SUBSCRIPTION_ID_MARKETING=
HS_COMM_TEXT=

# Google Sheets enrichment (prefer service account credentials)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=ALL8_Leads
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional previously provisioned OAuth credentials. There is no public OAuth
# setup route; the token path must point outside the application checkout.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_PATH=
